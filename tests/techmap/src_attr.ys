read_rtlil << EOT
module \top
  wire output 1 \y
  attribute \src "bmux_src"
  cell $bmux \bmux
    parameter \WIDTH 1
    parameter \S_WIDTH 2
    connect \A 4'1010
    connect \S 2'00
    connect \Y \y
  end
end
EOT

bmuxmap -pmux
select -assert-count 4 t:$eq a:src=bmux_src %i
select -assert-count 1 t:$pmux a:src=bmux_src %i

design -reset

read_rtlil << EOT
module \top
  wire width 3 input 1 \b
  wire width 3 input 2 \s
  wire output 3 \y
  attribute \src "pmuxtree_src"
  cell $pmux \pmux
    parameter \WIDTH 1
    parameter \S_WIDTH 3
    connect \A 1'0
    connect \B \b
    connect \S \s
    connect \Y \y
  end
end
EOT

pmuxtree
select -assert-count 3 t:$mux a:src=pmuxtree_src %i
select -assert-count 1 t:$reduce_or a:src=pmuxtree_src %i
select -assert-count 1 t:$or a:src=pmuxtree_src %i
select -assert-count 1 t:$not a:src=pmuxtree_src %i

design -reset

read_rtlil << EOT
module \top
  wire input 1 \a
  wire output 2 \y
  attribute \src "lut_src"
  cell $lut \lut
    parameter \WIDTH 1
    parameter \LUT 2'10
    connect \A \a
    connect \Y \y
  end
end
EOT

lut2mux
select -assert-count 1 t:$_MUX_ a:src=lut_src %i

design -reset

read_rtlil << EOT
module \top
  wire input 1 \a
  wire output 2 \y
  attribute \src "lut_word_src"
  cell $lut \lut
    parameter \WIDTH 1
    parameter \LUT 2'10
    connect \A \a
    connect \Y \y
  end
end
EOT

lut2mux -word
select -assert-count 1 t:$mux a:src=lut_word_src %i

design -reset

read_rtlil << EOT
module \top
  wire input 1 \a
  wire input 2 \b
  wire output 3 \y
  attribute \src "aig_src"
  cell $xor \xor
    parameter \A_SIGNED 0
    parameter \B_SIGNED 0
    parameter \A_WIDTH 1
    parameter \B_WIDTH 1
    parameter \Y_WIDTH 1
    connect \A \a
    connect \B \b
    connect \Y \y
  end
end
EOT

aigmap
select -assert-any t:$_AND_ a:src=aig_src %i
select -assert-any t:$_NOT_ a:src=aig_src %i

design -reset

read_rtlil << EOT
module \top
  wire input 1 \a
  wire input 2 \b
  wire output 3 \y
  attribute \src "alu_src"
  cell $add \add
    parameter \A_SIGNED 0
    parameter \B_SIGNED 0
    parameter \A_WIDTH 1
    parameter \B_WIDTH 1
    parameter \Y_WIDTH 1
    connect \A \a
    connect \B \b
    connect \Y \y
  end
end
EOT

alumacc
select -assert-count 1 t:$alu a:src=alu_src %i

design -reset

read_rtlil << EOT
module \top
  wire input 1 \a
  wire input 2 \b
  wire width 2 input 3 \c
  wire width 2 \m
  wire width 2 output 4 \y
  cell $mul \mul
    parameter \A_SIGNED 0
    parameter \B_SIGNED 0
    parameter \A_WIDTH 1
    parameter \B_WIDTH 1
    parameter \Y_WIDTH 2
    connect \A \a
    connect \B \b
    connect \Y \m
  end
  attribute \src "macc_src"
  cell $add \add
    parameter \A_SIGNED 0
    parameter \B_SIGNED 0
    parameter \A_WIDTH 2
    parameter \B_WIDTH 2
    parameter \Y_WIDTH 2
    connect \A \m
    connect \B \c
    connect \Y \y
  end
end
EOT

alumacc
select -assert-count 1 t:$macc_v2 a:src=macc_src %i

design -reset

read_rtlil << EOT
module \top
  wire input 1 \clk
  wire input 2 \en
  wire input 3 \d
  wire output 4 \q
  attribute \src "clockgate_src"
  cell $dffe \ff
    parameter \CLK_POLARITY 1
    parameter \EN_POLARITY 1
    parameter \WIDTH 1
    connect \CLK \clk
    connect \EN \en
    connect \D \d
    connect \Q \q
  end
end
EOT

clockgate -pos ICG EN:CLK:GCLK
select -assert-count 1 t:ICG a:src=clockgate_src %i

design -reset

read_rtlil << EOT
module \top
  wire input 1 \clk
  wire input 2 \en
  wire input 3 \d
  wire output 4 \q
  attribute \src "clockgate_neg_src"
  cell $dffe \ff
    parameter \CLK_POLARITY 1
    parameter \EN_POLARITY 0
    parameter \WIDTH 1
    connect \CLK \clk
    connect \EN \en
    connect \D \d
    connect \Q \q
  end
end
EOT

clockgate -pos ICG EN:CLK:GCLK
select -assert-count 1 t:ICG a:src=clockgate_neg_src %i
select -assert-count 1 t:$_NOT_ a:src=clockgate_neg_src %i
