read_rtlil << EOT
module \top
  wire width 2 input 1 \a
  wire width 2 input 2 \b
  wire width 2 output 3 \y
  cell $and \and_12
    parameter \A_SIGNED 0
    parameter \B_SIGNED 0
    parameter \A_WIDTH 2
    parameter \B_WIDTH 2
    parameter \Y_WIDTH 2
    connect \A \a
    connect \B \b
    connect \Y \y
  end
end
EOT

simplemap
select -assert-count 1 c:and
select -assert-count 1 c:and_1
select -assert-count 0 c:$auto*

design -reset

read_rtlil << EOT
module \top
  wire input 1 \a
  wire output 2 \y
  cell $lut \lut_9
    parameter \WIDTH 1
    parameter \LUT 2'10
    connect \A \a
    connect \Y \y
  end
end
EOT

lut2mux
