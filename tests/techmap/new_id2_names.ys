read_rtlil << EOT
module \top
  wire width 2 input 1 \a
  wire width 2 input 2 \b
  wire width 2 output 3 \y
  cell $xor \xgroup_3
    parameter \A_SIGNED 0
    parameter \B_SIGNED 0
    parameter \A_WIDTH 2
    parameter \B_WIDTH 2
    parameter \Y_WIDTH 2
    connect \A { \a [0] 1'1 }
    connect \B { \b [0] \b [1] }
    connect \Y \y
  end
end
EOT

opt_expr -fine
select -assert-count 1 c:xgroup_3
select -assert-count 1 w:xgroup_3_grp_y

